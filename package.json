{
  "name": "rewrz-frontend-assets",
  "private": true,
  "scripts": {
    "build:css:site": "tailwindcss -c tailwind.config.js -i ./rewrz/static/css/src/site-tailwind.css -o ./rewrz/static/css/site-tailwind.css --minify",
    "build:css": "npm run build:css:site",
    "watch:css:site": "tailwindcss -c tailwind.config.js -i ./rewrz/static/css/src/site-tailwind.css -o ./rewrz/static/css/site-tailwind.css --watch",
    "watch:css": "npm run watch:css:site"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "tailwindcss": "^3.4.17"
  }
}
