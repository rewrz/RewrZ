# RewrZ 博客系统配置文件
# 仅供安装完成后的对照与补充，不建议在首次访问 /installer 前直接复制为 .env

# 数据库配置
DATABASE_URL=sqlite:///./data/rewrz.db
# 连接池配置（每个 worker 进程独立生效，默认值适合单机小站）
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true
# SQLite 并发配置（默认启用 WAL 与 30 秒 busy_timeout）
# SQLITE_BUSY_TIMEOUT_MS=30000
# SQLITE_JOURNAL_MODE=WAL

# 安全配置
SECRET_KEY=please-set-a-random-secret-key-before-production
# 可选强制开关：默认不写。Cookie 的 Secure 标志按请求自动判定
# （识别 X-Forwarded-Proto 与请求协议），HTTP/HTTPS/反代切换无需改配置
COOKIE_SECURE=false

# 后台路径配置（建议在生产环境中使用随机字符串）
ADMIN_PATH=/rewrz-admin

# 媒体文件上传目录
MEDIA_UPLOAD_DIR=media_uploads

# 开发环境配置
DEBUG=true
