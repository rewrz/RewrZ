# RewrZ 博客系统配置文件
# 仅供安装完成后的对照与补充，不建议在首次访问 /installer 前直接复制为 .env

# 数据库配置
DATABASE_URL=sqlite:///./data/rewrz.db
# 连接池配置（每个 worker 进程独立生效；SQLite 默认 10+10，其他数据库默认 10+20）
# 连接按需创建：空闲时不会占满，只有高并发时才扩展，优先保住读并发。
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=10
# 以下两项仅对网络数据库生效；本地 SQLite 默认关闭预检查与连接回收
# DB_POOL_RECYCLE=1800
# DB_POOL_PRE_PING=true
# SQLite 并发配置（默认启用 WAL、30 秒 busy_timeout）
# SQLITE_BUSY_TIMEOUT_MS=30000
# SQLITE_JOURNAL_MODE=WAL
# 每连接页缓存上限（KiB），默认 1MB；20 个连接最坏约 20MB
# SQLITE_CACHE_SIZE_KIB=1024
# 写入同步级别，WAL 下默认 NORMAL，减少 fsync、提升写吞吐
# SQLITE_SYNCHRONOUS=NORMAL

# 安全配置
SECRET_KEY=please-set-a-random-secret-key-before-production
# 可选强制开关：默认不写。Cookie 的 Secure 标志按请求自动判定
# （识别 X-Forwarded-Proto 与请求协议），HTTP/HTTPS/反代切换无需改配置
COOKIE_SECURE=false

# 后台路径配置（建议在生产环境中使用随机字符串）
ADMIN_PATH=/rewrz-admin

# 站点对外地址（可选）：用于生成密码重置等邮件链接，避免依赖请求 Host 头
# 留空时优先读取后台“站点地址”设置，仍为空则回退到当前请求地址
# SITE_URL=https://example.com

# Host 头白名单（可选，逗号分隔）：为空表示不启用校验
# 支持精确域名、子域通配（.example.com）与 *（允许任意 Host）
# 需要保留本机健康检查时请一并加入 127.0.0.1
# ALLOWED_HOSTS=example.com,127.0.0.1

# 可信反向代理地址/CIDR（逗号分隔）：仅这些直连地址发来的 X-Forwarded-For 会被采信
# 默认信任本机回环地址：
# - 前面有 Nginx 且已配置 real_ip 还原真实 IP：保持默认即可，不要把 CDN 边缘网段填进来
# - CDN / 反向代理直接回源到应用：需要填实际回源 IP 或网段，否则访问统计的 UV 与上报限流会按边缘 IP 计算
# TRUSTED_PROXIES=127.0.0.1,::1

# 登录令牌有效期（分钟，默认 1440 即 24 小时，允许范围 5-10080）
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 媒体文件上传目录
MEDIA_UPLOAD_DIR=media_uploads

# 开发环境配置
DEBUG=true
